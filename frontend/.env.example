# Backend API base URL. Use `localhost` rather than `127.0.0.1` in development: the
# refresh cookie is SameSite=Lax locally, and localhost:5173 -> localhost:5000 is
# same-site (differing ports are not), so the cookie is sent. 127.0.0.1 is a different
# site and the cookie would be silently dropped.
VITE_API_URL=http://localhost:5000/api

# Firebase web config. None of these are secrets — a web API key is a public project
# identifier that ships in every client bundle by design, and access is controlled by
# Firebase Security Rules and the authorized-domains list, not by hiding these values.
# They are here so the app can be pointed at another Firebase project without a code
# change. Leave blank to use the defaults baked into src/services/firebaseConfig.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
