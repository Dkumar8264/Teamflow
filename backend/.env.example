PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@<cluster-url>/teamflow?retryWrites=true&w=majority
MONGO_URI=

# Access-token signing secret. Must be at least 32 characters of high-entropy random
# data — the server refuses to boot in production on a short or placeholder value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Access-token lifetime. Keep this short: refresh tokens handle long sessions, and a
# leaked access token stays usable for exactly this long.
JWT_EXPIRES_IN=15m

# Refresh-token lifetime in days. Refresh tokens are opaque random values stored hashed
# in MongoDB and rotated on every use, so they are not JWTs and need no signing secret.
REFRESH_TOKEN_TTL_DAYS=7

# Frontend URLs allowed by CORS during local development.
# The first URL is also used to build links in invitation, verification, and reset emails.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Firebase Admin credentials, used only to verify Google sign-in ID tokens server-side.
# This is a real private key — never commit it and never expose it to the frontend.
# Download a service account JSON from
#   Firebase console -> Project settings -> Service accounts -> Generate new private key
# then paste it here as one line, either as raw JSON or base64-encoded (base64 is safer
# on hosts that mangle multi-line values):
#   node -e "console.log(require('fs').readFileSync('serviceAccountKey.json','base64'))"
# Leave blank to disable Google sign-in; POST /api/auth/google then returns 503.
FIREBASE_SERVICE_ACCOUNT=

# Firebase project id. Google ID tokens whose `aud` is not this value are rejected.
FIREBASE_PROJECT_ID=

# Email delivery for invitations, email verification, and password resets.
# Render free services block SMTP ports, so the Resend API is recommended in production.
RESEND_API_KEY=
MAIL_FROM=TeamFlow <onboarding@resend.dev>

# SMTP fallback for hosts that allow SMTP.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=TeamFlow <yourgmail@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FAMILY=4
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
