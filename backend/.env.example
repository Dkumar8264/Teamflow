PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@<cluster-url>/teamflow?retryWrites=true&w=majority
MONGO_URI=

# Use long, random strings in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL allowed by CORS during local development.
CLIENT_URL=http://localhost:5173
