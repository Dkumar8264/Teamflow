PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@<cluster-url>/teamflow?retryWrites=true&w=majority
MONGO_URI=

# Use long, random strings in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URLs allowed by CORS during local development.
# The first URL is also used in invitation emails.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# SMTP email delivery for invitations.
# Render free services block SMTP ports, so Resend API is recommended for production.
RESEND_API_KEY=
MAIL_FROM=TeamFlow <onboarding@resend.dev>

# SMTP fallback for hosts that allow SMTP.
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=TeamFlow <yourgmail@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FAMILY=4
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
