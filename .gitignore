node_modules/
backend/node_modules/
frontend/node_modules/

# Only literal `.env` was ignored before, which let variants through.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Private keys and service-account files. firebaseAdmin.js supports pointing
# GOOGLE_APPLICATION_CREDENTIALS at a local key file, and committing one to this public
# repo would be a live credential leak requiring rotation in the Google Cloud console.
*.pem
*.key
*.p12
*.pfx
*.jks
serviceAccount*.json
*serviceAccountKey*.json
gcp-*.json
firebase-adminsdk*.json

dist/
build/
coverage/
.vite/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
*.bak
*.orig
*.swp
*~
